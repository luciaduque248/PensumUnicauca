rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /academic_snapshots/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list: if false;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['academic_data', 'schema_version', 'updated_at'])
        && request.resource.data.academic_data is map
        && request.resource.data.schema_version is int
        && request.resource.data.updated_at is timestamp;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
