rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One document per authenticated student. No public reads or writes.
    match /academic_snapshots/{userId} {
      allow read, create, update, delete: if request.auth != null
        && request.auth.uid == userId
        && (request.method == 'get' || request.method == 'list'
            || request.resource.data.keys().hasOnly(['academic_data', 'schema_version', 'updated_at']));
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
